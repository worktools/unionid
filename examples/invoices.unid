enum Currency {
  CNY
  USD
}

struct Invoice {
  id: uuid
  subtotal: Decimal<18, 2>
  fee: Decimal<18, 2>
  currency: Currency
}

table invoices: Invoice {
  key id
}

create index invoices (subtotal)

insert many invoices [
  {currency: CNY, fee: decimal "0.10", id: uuid "01991d78-a32d-7c2f-8f31-4c499bf64d9a", subtotal: decimal "199.9"}
  {currency: USD, fee: decimal "0.00", id: uuid "01991d78-a32d-7c2f-8f31-4c499bf64d9b", subtotal: decimal "25"}
]

from invoices
aggregate {
  average_subtotal = decimal_avg subtotal 18 2 "half_even"
}

from invoices
derive {
  total = subtotal + fee
  tax = decimal_mul subtotal decimal "0.13" 18 2 "half_even"
}
filter subtotal >= decimal "100"
select {id, total, tax, currency}
sort id
