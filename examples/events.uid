type Event =
  Login {user text}
  | Purchase {item int, amount_cents int}
  | Failure {message text}
type EventRow =
  id int
  event Event

table events EventRow
  key id

insert many events [
  {id = 1, event = Login {user = "alice"}},
  {id = 2, event = Purchase {item = 42, amount_cents = 1990}},
  {id = 3, event = Failure {message = "network | timeout"}}
]

from events
filter event == Purchase {item = 42, amount_cents = 1990}
derive event_kind =
  match event
    Login {..} => "login"
    Purchase {..} => "purchase"
    Failure {..} => "failure"
select {id, event_kind, event}
