type Event =
  Login {user text}
  | Purchase {item int, amount_cents int}
  | Failure {message text}
type EventRow =
  id int
  event Event

table events EventRow
  key id

insert events {id = 1, event = Login {user = "alice"}}
insert events {id = 2, event = Purchase {item = 42, amount_cents = 1990}}
insert events {id = 3, event = Failure {message = "network | timeout"}}

from events
filter event == Purchase {item = 42, amount_cents = 1990}
select {id, event}
