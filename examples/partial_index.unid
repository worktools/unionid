# Conditional uniqueness with partial unique indexes:
# - email unique only among non-deleted accounts
# - (provider, external_id) unique only while a job is Active
enum JobState {
  Pending
  Active
}

struct Account {
  id: text
  email: text
  deleted_at: Option<text>
}

struct Job {
  id: int
  provider: text
  external_id: text
  state: JobState
}

table accounts: Account {
  key id
}

table jobs: Job {
  key id
}

create unique index accounts (email) if deleted_at == None

create unique index jobs (provider, external_id) if state == Active

# The same email can exist on soft-deleted rows; only one non-deleted row holds it.
insert accounts {
  deleted_at: None
  email: "shared@example.com"
  id: "alice"
}

insert accounts {
  deleted_at: Some("2026-01-01")
  email: "shared@example.com"
  id: "bob"
}

# Soft-deleting alice releases the email, then a new account can take it.
update accounts
filter id == "alice"
set deleted_at = Some("2026-02-01")

upsert accounts {
  deleted_at: None
  email: "shared@example.com"
  id: "dave"
}

# The same external ID may repeat across non-Active states.
insert jobs {
  external_id: "42"
  id: 1
  provider: "acme"
  state: Active
}

insert jobs {
  external_id: "42"
  id: 2
  provider: "acme"
  state: Pending
}

from accounts
sort id
select {id, email, deleted_at}

from jobs
sort id
select {id, provider, external_id, state}

# The planner uses the partial unique index only when filters imply its predicate.
explain
  from accounts
  filter deleted_at == None
  filter email == "shared@example.com"
