type Currency = CNY | USD

type Invoice = {
  id uuid,
  subtotal decimal 18 2,
  fee decimal 18 2,
  currency Currency,
}

table invoices Invoice
  key id

create index invoices (subtotal)

insert many invoices [
  {
    id = uuid "01991d78-a32d-7c2f-8f31-4c499bf64d9a",
    subtotal = decimal "199.9",
    fee = decimal "0.10",
    currency = CNY,
  },
  {
    id = uuid "01991d78-a32d-7c2f-8f31-4c499bf64d9b",
    subtotal = decimal "25",
    fee = decimal "0.00",
    currency = USD,
  },
]

from invoices
derive total = subtotal + fee
filter subtotal >= decimal "100"
select {id, total, currency}
sort id
