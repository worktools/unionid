sequence ids {start 1}
type Id = int
enum State {Pending, Done}
struct Detail {note: Option<text>}
struct Item {
  id: Id
  owner: text
  state: State
  detail: Detail
  public_id: uuid
  created_at: timestamp
}
table items: Item {
  key id
  default id = next(ids)
  default public_id = uuid_v7()
  default created_at = now()
}
